<Window x:Class="ToggleTask.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Language="en-GB" Title="Task Track" Width="460" Height="800" MinWidth="400" MinHeight="600" Background="#141218" Foreground="#E6E0E9" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#4F378B"/><Setter Property="Foreground" Value="#F1E5F4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="40"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#211729"/><Setter Property="Foreground" Value="#F1E5F4"/><Setter Property="BorderBrush" Value="#66516E"/></Style>
  <DataTemplate x:Key="SessionRow">
   <Border Padding="12" BorderBrush="#49454F" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><TextBlock Text="{Binding ProjectName}" FontSize="12" Foreground="#CAC4D0" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="{Binding DurationLabel}" HorizontalAlignment="Right"/><Button Content="Details" Click="Edit_Click" Tag="{Binding}"/></StackPanel>
   </Grid></Border>
  </DataTemplate>
 </Window.Resources>
 <DockPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding SyncState}" TextWrapping="Wrap" Padding="10" FontSize="11" Foreground="#CAC4D0"/>
  <StackPanel DockPanel.Dock="Top" Background="#211F26" Margin="0,0,0,10">
   <CheckBox Content="Manual mode (Ctrl+D)" IsChecked="{Binding ManualMode}" Foreground="#CAC4D0" Margin="20,15,20,8"/>
   <Grid Margin="20,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
    <TextBox Text="{Binding ActivityDescription,UpdateSourceTrigger=PropertyChanged}" ToolTip="What are you working on?" BorderThickness="0" Background="Transparent"/>
    <TextBlock Grid.Column="1" Text="{Binding FormattedElapsed}" VerticalAlignment="Center" FontFamily="Consolas"/>
    <Button Grid.Column="2" Content="{Binding TimerButtonText}" Click="Timer_Click" Background="#6750A4"/>
   </Grid>
   <ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProjectId}" Margin="20,8"/>
   <StackPanel Visibility="{Binding ManualMode,Converter={StaticResource BoolVisibility}}" Margin="20,5,20,15">
    <TextBlock Text="Start date"/><DatePicker SelectedDate="{Binding ManualDate}"/>
    <TextBlock Text="Duration · 26 = 0:26 · 126 = 1:26"/><TextBox Text="{Binding ManualDuration,UpdateSourceTrigger=PropertyChanged}"/>
   </StackPanel>
  </StackPanel>
  <TabControl Margin="10" Background="#141218" BorderThickness="0">
   <TabItem Header="List"><ListBox ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionRow}" Background="#211F26" Foreground="#E6E0E9" BorderThickness="0" HorizontalContentAlignment="Stretch"/></TabItem>
   <TabItem Header="Calendar">
    <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,10"><Button Content="←" Click="PreviousDay_Click"/><DatePicker SelectedDate="{Binding SelectedDay}" Width="130"/><Button Content="→" Click="NextDay_Click"/><Button Content="Today" Click="Today_Click"/><TextBlock Text="{Binding DayTotal}" Foreground="#E6E0E9" VerticalAlignment="Center" Margin="8,0"/></StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Height="1440">
      <ItemsControl ItemsSource="{Binding Hours}"><ItemsControl.ItemTemplate><DataTemplate><Border Height="60" BorderBrush="#49454F" BorderThickness="0,1,0,0"><TextBlock Text="{Binding}" Foreground="#CAC4D0" FontSize="10" Padding="4"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl ItemsSource="{Binding DayBlocks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding Top}"/><Setter Property="Canvas.Left" Value="60"/><Setter Property="Width" Value="270"/><Setter Property="Height" Value="{Binding Height}"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Button Click="Edit_Click" Tag="{Binding Session}" Margin="0" Padding="5" HorizontalContentAlignment="Left" VerticalContentAlignment="Top"><TextBlock Text="{Binding Session.Description}" TextWrapping="Wrap"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </Grid></ScrollViewer>
    </DockPanel>
   </TabItem>
   <TabItem Header="Activity">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top"><CheckBox Content="Track foreground apps" Foreground="#E6E0E9" Checked="Tracking_Changed" Unchecked="Tracking_Changed"/><TextBlock Text="App names and time intervals are stored on this device for 7 days. Tracking pauses when you lock the screen or are idle for 2 minutes. Use another app for at least 15 seconds to see a suggestion." TextWrapping="Wrap" Foreground="#CAC4D0" FontSize="12" Margin="0,12"/><Button Content="Clear my activity history" Click="ClearActivity_Click"/></StackPanel>
     <ListBox ItemsSource="{Binding Activity.Suggestions}" Background="#211F26" Foreground="#E6E0E9" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><Button Content="Review as a session" Tag="{Binding}" Click="Review_Click"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>

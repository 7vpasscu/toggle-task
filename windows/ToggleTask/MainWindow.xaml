<Window x:Class="ToggleTask.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Toggle Task" Width="940" Height="620" Background="#F7F8FA"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#101828" Padding="18"><StackPanel><TextBlock Text="Toggle Task" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="4,8,4,30"/><TextBlock Text="◷   Timer" Foreground="White" FontSize="15" Margin="4,0,0,18"/><TextBlock Text="☷   Actividad" Foreground="#98A2B3" FontSize="15"/></StackPanel></Border><Grid Grid.Column="1" Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,22"><TextBlock Text="Hoy" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SyncText" DockPanel.Dock="Right" Text="Datos simulados" Foreground="#667085"/></DockPanel><Border Grid.Row="1" Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,24"><StackPanel><TextBox Text="{Binding ActivityDescription,UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontSize="18" Padding="0,0,0,14"/><DockPanel><ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProjectId}" Width="360"/><TextBlock Text="{Binding FormattedElapsed}" FontFamily="Consolas" FontSize="26" Margin="Auto,0,18,0"/><Button Content="{Binding TimerButtonText}" Click="Timer_Click" Padding="18,10" Background="#2F80ED" Foreground="White"/></DockPanel></StackPanel></Border><DockPanel Grid.Row="2"><TextBlock DockPanel.Dock="Top" Text="Sesiones recientes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><ListView ItemsSource="{Binding Sessions}" BorderThickness="0" Background="Transparent"><ListView.ItemTemplate><DataTemplate><Border Background="White" Padding="10" BorderBrush="#EAECF0" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Description}"/><TextBlock Text="{Binding ProjectName}" Foreground="#667085" FontSize="12"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DurationSeconds,StringFormat={}{0}s}" HorizontalAlignment="Right" FontFamily="Consolas"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></DockPanel></Grid></Grid></Window>
